{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist/ruta-demo/browser",
  "routes": [
    {
      "src": "^/$",
      "headers": {
        "Location": "/demo?tour=1"
      },
      "status": 307
    },
    {
      "src": "^/demo/?$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": ".*",
      "status": 404
    }
  ]
}
