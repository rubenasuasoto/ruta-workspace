{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist/ruta-demo/browser",
  "redirects": [
    {
      "source": "/",
      "destination": "/demo?tour=1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/index.html"
    }
  ]
}
